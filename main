                    value: history.isEmpty
                        ? '--'
                        : fmtPercent(history.averagePercent),
                    color: kIndigo,
                  ),
                ),
                const SizedBox(width: 12),
                Expanded(
                  child: StatCard(
                    icon: Icons.check_circle_outline_rounded,
                    label: 'Total correct answers',
                    value: '${history.totalCorrect}',
                    color: const Color(0xFF0EA5E9),
                  ),
                ),
              ],
            ),
          ),
          if (history.bestCategory != null)
            Padding(
              padding: const EdgeInsets.only(top: 8, left: 4),
              child: Text(
                'Strongest subject: ${history.bestCategory}',
                style: theme.textTheme.bodySmall
                    ?.copyWith(color: Colors.blueGrey.shade600),
              ),
            ),
          const SizedBox(height: 16),
          FadeSlideIn(
            delayMs: 220,
            child: AppCard(
              child: Column(
                children: [
                  infoRow(Icons.badge_rounded, 'Roll number', '25PA5A0530'),
                  const Divider(height: 1),
                  infoRow(Icons.email_rounded, 'Email',
                      '25pa5a0530@vishnu.edu.in'),
                  const Divider(height: 1),
                  infoRow(Icons.school_rounded, 'College',
                      'Vishnu Institute of Technology'),
                  const Divider(height: 1),
                  infoRow(Icons.calendar_month_rounded, 'Member since',
                      'August 2024'),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

