// QuizMaster - Smart Quiz Practice App
// Single-file Flutter app for DartPad (Flutter mode). No external packages.
import 'dart:async';
import 'dart:math' as math;

import 'package:flutter/material.dart';

void main() => runApp(const QuizMasterApp());

// ============================================================================
// CONSTANTS & THEME
// ============================================================================

const Color kBlue = Color(0xFF2563EB);
const Color kPurple = Color(0xFF7C3AED);
const Color kIndigo = Color(0xFF4F46E5);
const Color kBackground = Color(0xFFF4F5FF);

const LinearGradient kBrandGradient = LinearGradient(
  colors: [kBlue, kPurple],
  begin: Alignment.topLeft,
  end: Alignment.bottomRight,
);

const int kSecondsPerQuestion = 60;
const String kStudentName = 'Arjun Reddy';
const String kStudentFirstName = 'Arjun';

class QuizMasterApp extends StatelessWidget {
  const QuizMasterApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'QuizMaster',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: kIndigo,
          brightness: Brightness.light,
        ),
        scaffoldBackgroundColor: kBackground,
        appBarTheme: const AppBarTheme(
          backgroundColor: Colors.transparent,
          elevation: 0,
          scrolledUnderElevation: 0,
          centerTitle: true,
        ),
        filledButtonTheme: FilledButtonThemeData(
          style: FilledButton.styleFrom(
            minimumSize: const Size(64, 52),
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(16),
            ),
          ),
        ),
        outlinedButtonTheme: OutlinedButtonThemeData(
          style: OutlinedButton.styleFrom(
            minimumSize: const Size(64, 52),
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(16),
            ),
          ),
        ),
      ),
      home: const AppShell(),
    );
  }
}

// ============================================================================
// MODELS
// ============================================================================

class Question {
  final String text;
  final List<String> options;
  final int answer; // index of the correct option
  final String explanation;

  const Question(this.text, this.options, this.answer, this.explanation);
}

class QuizCategory {
  final String name;
  final IconData icon;
  final Color color;
  final List<Question> questions;

  const QuizCategory({
    required this.name,
    required this.icon,
    required this.color,
    required this.questions,
  });

  int get totalSeconds => questions.length * kSecondsPerQuestion;
}

class ReviewItem {
  final Question question;
  final int selected; // -1 when unanswered

  const ReviewItem(this.question, this.selected);

  bool get answered => selected >= 0;
  bool get correct => selected == question.answer;
}

class QuizResult {
  final QuizCategory category;
  final int total;
  final int correct;
  final int incorrect;
  final int unanswered;
  final int secondsTaken;
  final DateTime completedAt;
  final List<ReviewItem> review;

  const QuizResult({
    required this.category,
    required this.total,
    required this.correct,
    required this.incorrect,
    required this.unanswered,
    required this.secondsTaken,
    required this.completedAt,
    required this.review,
  });

  double get percent => total == 0 ? 0 : correct * 100 / total;
}

class LeaderboardEntry {
  final String name;
  final int score;
  final int quizzes;
  final double average;
  final bool isYou;

  const LeaderboardEntry(
    this.name,
    this.score,
    this.quizzes,
    this.average, {
    this.isYou = false,
  });
}

extension HistoryStats on List<QuizResult> {
  double get bestPercent =>
      isEmpty ? 0 : map((r) => r.percent).reduce(math.max);

  double get averagePercent =>
      isEmpty ? 0 : fold<double>(0, (s, r) => s + r.percent) / length;

  int get totalCorrect => fold<int>(0, (s, r) => s + r.correct);

  String? get bestCategory {
    if (isEmpty) return null;
    QuizResult best = first;
    for (final r in this) {
      if (r.percent > best.percent) best = r;
    }
    return best.category.name;
  }
}

// ============================================================================
// HELPERS
// ============================================================================

String fmtDuration(int seconds) {
  final s = seconds < 0 ? 0 : seconds;
  final m = (s ~/ 60).toString().padLeft(2, '0');
  final r = (s % 60).toString().padLeft(2, '0');
  return '$m:$r';
}

String fmtPercent(double p) => '${p.round()}%';

String fmtDate(DateTime d) {
  const months = [
    'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
  ];
  final hour = d.hour % 12 == 0 ? 12 : d.hour % 12;
  final minute = d.minute.toString().padLeft(2, '0');
  final suffix = d.hour >= 12 ? 'PM' : 'AM';
  return '${d.day} ${months[d.month - 1]} ${d.year}, $hour:$minute $suffix';
}

String performanceMessage(double p) {
  if (p >= 90) return 'Outstanding! You have mastered this topic.';
  if (p >= 75) return 'Excellent work! Keep up the momentum.';
  if (p >= 60) return 'Good job! A little more practice will make you perfect.';
  if (p >= 40) return 'Fair attempt. Review the explanations and try again.';
  return 'Keep practising. Every attempt makes you stronger!';
}

IconData performanceIcon(double p) {
  if (p >= 90) return Icons.emoji_events_rounded;
  if (p >= 75) return Icons.workspace_premium_rounded;
  if (p >= 60) return Icons.thumb_up_alt_rounded;
  if (p >= 40) return Icons.trending_up_rounded;
  return Icons.fitness_center_rounded;
}

String initials(String name) {
  final parts = name.trim().split(RegExp(r'\s+'));
  if (parts.isEmpty || parts.first.isEmpty) return '?';
  if (parts.length == 1) return parts.first[0].toUpperCase();
  return (parts.first[0] + parts.last[0]).toUpperCase();
}

Route<T> fadeSlideRoute<T>(Widget page) {
  return PageRouteBuilder<T>(
    transitionDuration: const Duration(milliseconds: 350),
    reverseTransitionDuration: const Duration(milliseconds: 250),
    pageBuilder: (context, animation, secondaryAnimation) => page,
    transitionsBuilder: (context, animation, secondaryAnimation, child) {
      final curved =
          CurvedAnimation(parent: animation, curve: Curves.easeOutCubic);
      return FadeTransition(
        opacity: curved,
        child: SlideTransition(
          position: Tween<Offset>(
            begin: const Offset(0, 0.04),
            end: Offset.zero,
          ).animate(curved),
          child: child,
        ),
      );
    },
  );
}

