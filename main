class ResultScreen extends StatelessWidget {
  final QuizResult result;
  final bool autoSubmitted;

  const ResultScreen({
    super.key,
    required this.result,
    this.autoSubmitted = false,
  });

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final scheme = theme.colorScheme;
    final p = result.percent;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Quiz Result',
            style: TextStyle(fontWeight: FontWeight.w800)),
      ),
      body: ResponsiveBody(
        maxWidth: 640,
        child: ListView(
          padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
          children: [
            if (autoSubmitted)
              Container(
                margin: const EdgeInsets.only(bottom: 12),
                padding: const EdgeInsets.all(14),
                decoration: BoxDecoration(
                  color: Colors.amber.shade50,
                  borderRadius: BorderRadius.circular(16),
                  border: Border.all(color: Colors.amber.shade300),
                ),
                child: Row(
                  children: [
                    Icon(Icons.timer_off_rounded, color: Colors.amber.shade800),
                    const SizedBox(width: 12),
                    const Expanded(
                      child: Text(
                          "Time's up! Your quiz was submitted automatically."),
                    ),
                  ],
                ),
              ),
            FadeSlideIn(
              child: AppCard(
                padding: const EdgeInsets.all(24),
                child: Column(
                  children: [
                    Text(
                      result.category.name,
                      style: theme.textTheme.titleMedium?.copyWith(
                        fontWeight: FontWeight.w800,
                        color: kIndigo,
                      ),
                    ),
                    const SizedBox(height: 20),
                    TweenAnimationBuilder<double>(
                      tween: Tween<double>(begin: 0, end: p / 100),
                      duration: const Duration(milliseconds: 1300),
                      curve: Curves.easeOutCubic,
                      builder: (context, value, _) => SizedBox(
                        width: 180,
                        height: 180,
                        child: Stack(
                          fit: StackFit.expand,
                          children: [
                            CircularProgressIndicator(
                              value: value,
                              strokeWidth: 14,
                              backgroundColor: kIndigo.withValues(alpha: 0.12),
                              color: scheme.primary,
                            ),
                            Center(
                              child: Column(
                                mainAxisSize: MainAxisSize.min,
                                children: [
                                  Text(
                                    '${(value * 100).round()}%',
                                    style: theme.textTheme.displaySmall
                                        ?.copyWith(
                                      fontWeight: FontWeight.w900,
                                      color: const Color(0xFF1E1B4B),
                                    ),
                                  ),
                                  Text(
                                    'Score',
                                    style: theme.textTheme.bodySmall?.copyWith(
                                        color: Colors.blueGrey.shade600),
                                  ),
                                ],
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 20),
                    Text(
                      '${result.correct} / ${result.total} correct',
                      style: theme.textTheme.titleLarge
                          ?.copyWith(fontWeight: FontWeight.w800),
                    ),
                    const SizedBox(height: 14),
                    Container(
                      padding: const EdgeInsets.all(14),
                      decoration: BoxDecoration(
                        color: scheme.primaryContainer.withValues(alpha: 0.6),
                        borderRadius: BorderRadius.circular(16),
                      ),
                      child: Row(
                        children: [
                          Icon(performanceIcon(p), color: scheme.primary),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Text(
                              performanceMessage(p),
                              style: const TextStyle(fontWeight: FontWeight.w600),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),
            FadeSlideIn(
              delayMs: 120,
              child: Row(
                children: [
                  Expanded(
                    child: _ResultStat(
                      icon: Icons.check_circle_rounded,
                      label: 'Correct',
                      value: '${result.correct}',
                      color: Colors.green.shade600,
                    ),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: _ResultStat(
                      icon: Icons.cancel_rounded,
                      label: 'Incorrect',
                      value: '${result.incorrect}',
                      color: Colors.red.shade500,
                    ),
                  ),
                  const SizedBox(width: 10),
                  Expanded(
                    child: _ResultStat(
                      icon: Icons.help_rounded,
                      label: 'Unanswered',
                      value: '${result.unanswered}',
                      color: Colors.blueGrey,
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),
            FadeSlideIn(
              delayMs: 200,
              child: AppCard(
                child: Row(
                  children: [
                    const Icon(Icons.timer_outlined, color: kIndigo),
                    const SizedBox(width: 12),
                    const Expanded(child: Text('Time taken')),
                    Text(
                      '${fmtDuration(result.secondsTaken)} / ${fmtDuration(result.category.totalSeconds)}',
                      style: const TextStyle(fontWeight: FontWeight.w800),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 24),
            FilledButton.icon(
              onPressed: () => Navigator.of(context).push(
                fadeSlideRoute<void>(ReviewScreen(result: result)),
              ),
              icon: const Icon(Icons.fact_check_rounded),
              label: const Text('Review Answers'),
            ),
            const SizedBox(height: 12),
            OutlinedButton.icon(
              onPressed: () =>
                  Navigator.of(context).popUntil((route) => route.isFirst),
              icon: const Icon(Icons.home_rounded),
              label: const Text('Back to Home'),
            ),
          ],
        ),
      ),
    );
  }
}

class _ResultStat extends StatelessWidget {
  final IconData icon;
  final String label;
  final String value;
  final Color color;

  const _ResultStat({
    required this.icon,
    required this.label,
    required this.value,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return AppCard(
      padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 16),
      child: Column(
        children: [
          Icon(icon, color: color, size: 28),
          const SizedBox(height: 8),
          Text(
            value,
            style: theme.textTheme.headlineSmall
                ?.copyWith(fontWeight: FontWeight.w900, color: color),
          ),
          Text(
            label,
            style: theme.textTheme.bodySmall
                ?.copyWith(color: Colors.blueGrey.shade600),
          ),
        ],
      ),
    );
  }
}

// ============================================================================
// ANSWER REVIEW SCREEN
// ============================================================================

class ReviewScreen extends StatelessWidget {
  final QuizResult result;

  const ReviewScreen({super.key, required this.result});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Answer Review',
            style: TextStyle(fontWeight: FontWeight.w800)),
      ),
      body: ResponsiveBody(
        maxWidth: 720,
        child: ListView.builder(
          padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
          itemCount: result.review.length,
          itemBuilder: (context, i) => Padding(
            padding: const EdgeInsets.only(bottom: 16),
            child: FadeSlideIn(
              delayMs: i * 60,
              child: _ReviewCard(number: i + 1, item: result.review[i]),
            ),
          ),
        ),
      ),
    );
  }
}

class _ReviewCard extends StatelessWidget {
  final int number;
  final ReviewItem item;

  const _ReviewCard({required this.number, required this.item});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final q = item.question;

    final Color statusColor;
    final String statusText;
    final IconData statusIcon;
    if (!item.answered) {
      statusColor = Colors.blueGrey;
      statusText = 'Unanswered';
      statusIcon = Icons.help_rounded;
    } else if (item.correct) {
      statusColor = Colors.green.shade600;
      statusText = 'Correct';
      statusIcon = Icons.check_circle_rounded;
    } else {
      statusColor = Colors.red.shade500;
      statusText = 'Incorrect';
      statusIcon = Icons.cancel_rounded;
    }

    return AppCard(
      padding: const EdgeInsets.all(18),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Text(
                'Question $number',
                style: theme.textTheme.titleSmall?.copyWith(
                  fontWeight: FontWeight.w800,
                  color: kIndigo,
                ),
              ),
              const Spacer(),
              Container(
                padding:
                    const EdgeInsets.symmetric(horizontal: 10, vertical: 5),
                decoration: BoxDecoration(
                  color: statusColor.withValues(alpha: 0.12),
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(statusIcon, size: 16, color: statusColor),
                    const SizedBox(width: 4),
                    Text(
                      statusText,
                      style: TextStyle(
                        color: statusColor,
                        fontWeight: FontWeight.w700,
                        fontSize: 12,
                      ),
                    ),
                  ],
                ),
              ),
            ],
          ),
          const SizedBox(height: 12),
          Text(
            q.text,
            style: theme.textTheme.titleMedium
                ?.copyWith(fontWeight: FontWeight.w700, height: 1.4),
          ),
          const SizedBox(height: 14),
          for (var i = 0; i < q.options.length; i++) _buildOption(context, i),
          const SizedBox(height: 4),
          Container(
            width: double.infinity,
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              color: kIndigo.withValues(alpha: 0.07),
              borderRadius: BorderRadius.circular(14),
            ),
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Icon(Icons.lightbulb_rounded, color: kIndigo, size: 20),
                const SizedBox(width: 10),
                Expanded(
                  child: Text(
                    q.explanation,
                    style: theme.textTheme.bodyMedium?.copyWith(height: 1.4),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildOption(BuildContext context, int i) {
    final q = item.question;
    final isCorrect = i == q.answer;
    final isSelected = i == item.selected;

    Color bg = Colors.white;
    Color border = Colors.grey.shade300;
    Color accent = Colors.blueGrey.shade600;
    String? tag;
    IconData? trailing;

    if (isCorrect) {
      bg = Colors.green.withValues(alpha: 0.12);
      border = Colors.green.shade500;
      accent = Colors.green.shade700;
      tag = isSelected ? 'Your answer - Correct' : 'Correct answer';
      trailing = Icons.check_circle_rounded;
    } else if (isSelected) {
      bg = Colors.red.withValues(alpha: 0.10);
      border = Colors.red.shade400;
      accent = Colors.red.shade600;
      tag = 'Your answer';
      trailing = Icons.cancel_rounded;
    }

    return Container(
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: bg,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: border, width: tag == null ? 1 : 1.8),
      ),
      child: Row(
        children: [
          Text(
            String.fromCharCode(65 + i),
            style: TextStyle(fontWeight: FontWeight.w800, color: accent),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(q.options[i]),
                if (tag != null)
                  Text(
                    tag,
                    style: TextStyle(
                      fontSize: 12,
                      fontWeight: FontWeight.w700,
                      color: accent,
                    ),
                  ),
              ],
            ),
          ),
          if (trailing != null) Icon(trailing, color: accent),
        ],
      ),
    );
  }
}

// ============================================================================
// HISTORY TAB
// ============================================================================

class HistoryTab extends StatelessWidget {
  final List<QuizResult> history;

  const HistoryTab({super.key, required this.history});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final items = history.reversed.toList();

    return ResponsiveBody(
      maxWidth: 720,
      child: items.isEmpty
          ? Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: const [
                Padding(
                  padding: EdgeInsets.fromLTRB(16, 20, 16, 0),
                  child: SectionTitle('Quiz History',
                      subtitle: 'Your completed quizzes appear here'),
                ),
                Expanded(
                  child: EmptyState(
                    icon: Icons.history_rounded,
                    title: 'No quizzes yet',
                    message:
                        'Complete a quiz from the Home tab and your results will be listed here for this session.',
                  ),
                ),
              ],
            )
          : ListView(
              padding: const EdgeInsets.fromLTRB(16, 20, 16, 24),
              children: [
                SectionTitle(
                  'Quiz History',
                  subtitle:
                      '${items.length} quiz${items.length == 1 ? '' : 'zes'} completed this session',
                ),
                const SizedBox(height: 16),
                for (var i = 0; i < items.length; i++)
                  Padding(
                    padding: const EdgeInsets.only(bottom: 12),
                    child: FadeSlideIn(
                      delayMs: i * 50,
                      child: AppCard(
                        onTap: () => Navigator.of(context).push(
                          fadeSlideRoute<void>(ResultScreen(result: items[i])),
                        ),
                        child: Row(
                          children: [
                            Container(
                              width: 50,
                              height: 50,
                              decoration: BoxDecoration(
                                color: items[i].category.color,
                                borderRadius: BorderRadius.circular(16),
                              ),
                              child: Icon(items[i].category.icon,
                                  color: Colors.white),
                            ),
                            const SizedBox(width: 14),
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(
                                    items[i].category.name,
                                    style: theme.textTheme.titleSmall
                                        ?.copyWith(fontWeight: FontWeight.w800),
                                  ),
                                  const SizedBox(height: 2),
                                  Text(
                                    'Score ${items[i].correct}/${items[i].total}  |  ${fmtDate(items[i].completedAt)}',
                                    style: theme.textTheme.bodySmall?.copyWith(
                                        color: Colors.blueGrey.shade600),
                                  ),
                                ],
                              ),
                            ),
                            const SizedBox(width: 8),
                            Container(
                              padding: const EdgeInsets.symmetric(
                                  horizontal: 12, vertical: 8),
                              decoration: BoxDecoration(
                                color: kIndigo.withValues(alpha: 0.1),
                                borderRadius: BorderRadius.circular(14),
                              ),
                              child: Text(
                                fmtPercent(items[i].percent),
                                style: const TextStyle(
                                  color: kIndigo,
                                  fontWeight: FontWeight.w900,
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),
                Center(
                  child: Text(
                    'Tap a quiz to see details and review answers',
                    style: theme.textTheme.bodySmall
                        ?.copyWith(color: Colors.blueGrey.shade400),
                  ),
                ),
              ],
            ),
    );
  }
}

// ============================================================================
// LEADERBOARD TAB
// ============================================================================

const List<LeaderboardEntry> kSampleLeaderboard = [
  LeaderboardEntry('Ananya Sharma', 182, 20, 92),
  LeaderboardEntry('Rahul Verma', 171, 19, 90),
  LeaderboardEntry('Priya Nair', 165, 18, 88),
  LeaderboardEntry('Karthik Reddy', 158, 18, 86),
  LeaderboardEntry('Sneha Iyer', 149, 17, 84),
  LeaderboardEntry('Mohammed Faiz', 142, 16, 82),
  LeaderboardEntry('Divya Patel', 133, 15, 80),
  LeaderboardEntry('Vikram Singh', 125, 14, 78),
  LeaderboardEntry('Meera Joshi', 118, 14, 76),
  LeaderboardEntry('Aditya Kumar', 109, 13, 74),
];

class LeaderboardTab extends StatelessWidget {
  final List<QuizResult> history;

  const LeaderboardTab({super.key, required this.history});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    final entries = <LeaderboardEntry>[...kSampleLeaderboard];
    if (history.isNotEmpty) {
      entries.add(LeaderboardEntry(
        '$kStudentName (You)',
        history.totalCorrect,
        history.length,
        history.averagePercent,
        isYou: true,
      ));
    }
    entries.sort((a, b) => b.score.compareTo(a.score));
    final yourRank = entries.indexWhere((e) => e.isYou) + 1;

    return ResponsiveBody(
      maxWidth: 720,
      child: ListView(
        padding: const EdgeInsets.fromLTRB(16, 20, 16, 24),
        children: [
          const SectionTitle('Leaderboard',
              subtitle: 'Top performers ranked by total marks'),
          const SizedBox(height: 16),
          FadeSlideIn(
            child: AppCard(
              gradient: kBrandGradient,
              child: Row(
                children: [
                  const Icon(Icons.military_tech_rounded,
                      color: Colors.white, size: 40),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          yourRank > 0 ? 'Your rank: #$yourRank' : 'Join the race!',
                          style: theme.textTheme.titleMedium?.copyWith(
                            color: Colors.white,
                            fontWeight: FontWeight.w800,
                          ),
                        ),
                        Text(
                          yourRank > 0
                              ? '${history.totalCorrect} marks from ${history.length} quiz${history.length == 1 ? '' : 'zes'}'
                              : 'Complete a quiz to appear on the leaderboard.',
                          style: theme.textTheme.bodySmall?.copyWith(
                            color: Colors.white.withValues(alpha: 0.9),
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 16),
          for (var i = 0; i < entries.length; i++)
            Padding(
              padding: const EdgeInsets.only(bottom: 12),
              child: FadeSlideIn(
                delayMs: i * 50,
                child: _LeaderboardCard(rank: i + 1, entry: entries[i]),
              ),
            ),
        ],
      ),
    );
  }
}

class _LeaderboardCard extends StatelessWidget {
  final int rank;
  final LeaderboardEntry entry;

  const _LeaderboardCard({required this.rank, required this.entry});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final scheme = theme.colorScheme;

    final Color? medal = switch (rank) {
      1 => const Color(0xFFF5B301),
      2 => const Color(0xFF9CA3AF),
      3 => const Color(0xFFCD7F32),
      _ => null,
    };

    return AppCard(
      borderColor: entry.isYou ? scheme.primary : null,
      color: entry.isYou ? scheme.primaryContainer.withValues(alpha: 0.5) : null,
      child: Row(
        children: [
          SizedBox(
            width: 38,
            child: medal != null
                ? Icon(Icons.emoji_events_rounded, color: medal, size: 32)
                : Text(
                    '#$rank',
                    textAlign: TextAlign.center,
                    style: theme.textTheme.titleMedium?.copyWith(
                      fontWeight: FontWeight.w800,
                      color: Colors.blueGrey.shade600,
                    ),
                  ),
          ),
          const SizedBox(width: 10),
          CircleAvatar(
            radius: 22,
            backgroundColor: entry.isYou ? kPurple : kBlue.withValues(alpha: 0.15),
            child: Text(
              initials(entry.name.replaceAll(' (You)', '')),
              style: TextStyle(
                fontWeight: FontWeight.w800,
                color: entry.isYou ? Colors.white : kBlue,
              ),
            ),
          ),
          const SizedBox(width: 12),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  entry.name,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: theme.textTheme.titleSmall
                      ?.copyWith(fontWeight: FontWeight.w800),
                ),
                Text(
                  '${entry.quizzes} quizzes  |  avg ${fmtPercent(entry.average)}',
                  style: theme.textTheme.bodySmall
                      ?.copyWith(color: Colors.blueGrey.shade600),
                ),
              ],
            ),
          ),
          Column(
            crossAxisAlignment: CrossAxisAlignment.end,
            children: [
              Text(
                '${entry.score}',
                style: theme.textTheme.titleLarge?.copyWith(
                  fontWeight: FontWeight.w900,
                  color: kIndigo,
                ),
              ),
              Text('marks', style: theme.textTheme.bodySmall),
            ],
          ),
        ],
      ),
    );
  }
}

