class OptionTile extends StatelessWidget {
  final String label;
  final String text;
  final bool selected;
  final VoidCallback onTap;

  const OptionTile({
    super.key,
    required this.label,
    required this.text,
    required this.selected,
    required this.onTap,
  });

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;
    final radius = BorderRadius.circular(18);
    return Padding(
      padding: const EdgeInsets.only(bottom: 12),
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 220),
        curve: Curves.easeOut,
        decoration: BoxDecoration(
          color: selected ? scheme.primaryContainer : Colors.white,
          borderRadius: radius,
          border: Border.all(
            color: selected ? scheme.primary : Colors.grey.shade300,
            width: selected ? 2 : 1.2,
          ),
          boxShadow: selected
              ? [
                  BoxShadow(
                    color: scheme.primary.withValues(alpha: 0.18),
                    blurRadius: 14,
                    offset: const Offset(0, 6),
                  ),
                ]
              : const [],
        ),
        child: Material(
          type: MaterialType.transparency,
          child: InkWell(
            borderRadius: radius,
            onTap: onTap,
            child: Padding(
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
              child: Row(
                children: [
                  AnimatedContainer(
                    duration: const Duration(milliseconds: 220),
                    width: 36,
                    height: 36,
                    alignment: Alignment.center,
                    decoration: BoxDecoration(
                      shape: BoxShape.circle,
                      color: selected ? scheme.primary : kIndigo.withValues(alpha: 0.1),
                    ),
                    child: Text(
                      label,
                      style: TextStyle(
                        fontWeight: FontWeight.w800,
                        color: selected ? Colors.white : kIndigo,
                      ),
                    ),
                  ),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Text(
                      text,
                      style: Theme.of(context).textTheme.bodyLarge?.copyWith(
                            fontWeight:
                                selected ? FontWeight.w700 : FontWeight.w500,
                          ),
                    ),
                  ),
                  AnimatedOpacity(
                    duration: const Duration(milliseconds: 200),
                    opacity: selected ? 1 : 0,
                    child: Icon(Icons.check_circle_rounded,
                        color: scheme.primary),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

// ============================================================================
// APP SHELL (bottom navigation + session state)
// ============================================================================

class AppShell extends StatefulWidget {
  const AppShell({super.key});

  @override
  State<AppShell> createState() => _AppShellState();
}

class _AppShellState extends State<AppShell> {
  int _index = 0;
  final List<QuizResult> _history = [];

  void _addResult(QuizResult result) {
    setState(() => _history.add(result));
  }

  Widget _buildPage() {
    switch (_index) {
      case 0:
        return HomeTab(history: _history, onQuizComplete: _addResult);
      case 1:
        return HistoryTab(history: _history);
      case 2:
        return LeaderboardTab(history: _history);
      default:
        return ProfileTab(history: _history);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: AnimatedSwitcher(
        duration: const Duration(milliseconds: 300),
        switchInCurve: Curves.easeOut,
        transitionBuilder: (child, animation) => FadeTransition(
          opacity: animation,
          child: SlideTransition(
            position: Tween<Offset>(
              begin: const Offset(0, 0.02),
              end: Offset.zero,
            ).animate(animation),
            child: child,
          ),
        ),
        child: KeyedSubtree(key: ValueKey<int>(_index), child: _buildPage()),
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _index,
        onDestinationSelected: (i) => setState(() => _index = i),
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home_outlined),
            selectedIcon: Icon(Icons.home_rounded),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.history_outlined),
            selectedIcon: Icon(Icons.history_rounded),
            label: 'History',
          ),
          NavigationDestination(
            icon: Icon(Icons.leaderboard_outlined),
            selectedIcon: Icon(Icons.leaderboard_rounded),
            label: 'Leaderboard',
          ),
          NavigationDestination(
            icon: Icon(Icons.person_outline_rounded),
            selectedIcon: Icon(Icons.person_rounded),
            label: 'Profile',
          ),
        ],
      ),
    );
  }
}

// ============================================================================
// HOME TAB
// ============================================================================

class HomeTab extends StatelessWidget {
  final List<QuizResult> history;
  final ValueChanged<QuizResult> onQuizComplete;

  const HomeTab({
    super.key,
    required this.history,
    required this.onQuizComplete,
  });

  void _showStartSheet(BuildContext context, QuizCategory category) {
    showModalBottomSheet<void>(
      context: context,
      showDragHandle: true,
      isScrollControlled: true,
      constraints: const BoxConstraints(maxWidth: 560),
      builder: (sheetContext) {
        final theme = Theme.of(sheetContext);
        Widget info(IconData icon, String text) => Padding(
              padding: const EdgeInsets.symmetric(vertical: 6),
              child: Row(
                children: [
                  Icon(icon, size: 20, color: kIndigo),
                  const SizedBox(width: 12),
                  Expanded(child: Text(text)),
                ],
              ),
            );
        return SafeArea(
          child: Padding(
            padding: const EdgeInsets.fromLTRB(24, 4, 24, 24),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Container(
                      width: 56,
                      height: 56,
                      decoration: BoxDecoration(
                        color: category.color,
                        borderRadius: BorderRadius.circular(18),
                      ),
                      child: Icon(category.icon, color: Colors.white, size: 30),
                    ),
                    const SizedBox(width: 16),
                    Expanded(
                      child: Text(
                        category.name,
                        style: theme.textTheme.titleLarge
                            ?.copyWith(fontWeight: FontWeight.w800),
                      ),
                    ),
                  ],
                ),
                const SizedBox(height: 20),
                info(Icons.quiz_rounded,
                    '${category.questions.length} multiple-choice questions'),
                info(Icons.timer_rounded,
                    'Time limit: ${fmtDuration(category.totalSeconds)} minutes'),
                info(Icons.add_task_rounded, '1 mark for each correct answer'),
                info(Icons.shield_rounded, 'No negative marking'),
                info(Icons.shuffle_rounded, 'Questions appear in random order'),
                const SizedBox(height: 24),
                SizedBox(
                  width: double.infinity,
                  child: FilledButton.icon(
                    icon: const Icon(Icons.play_arrow_rounded),
                    label: const Text('Start Quiz'),
                    onPressed: () {
                      Navigator.of(sheetContext).pop();
                      Navigator.of(context).push(
                        fadeSlideRoute<void>(
                          QuizScreen(
                            category: category,
                            onComplete: onQuizComplete,
                          ),
                        ),
                      );
                    },
                  ),
                ),
              ],
            ),
          ),
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    return ResponsiveBody(
      maxWidth: 1000,
      child: CustomScrollView(
        slivers: [
          SliverToBoxAdapter(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(16, 16, 16, 0),
              child: FadeSlideIn(
                child: Container(
                  padding: const EdgeInsets.all(22),
                  decoration: BoxDecoration(
                    gradient: kBrandGradient,
                    borderRadius: BorderRadius.circular(28),
                    boxShadow: [
                      BoxShadow(
                        color: kPurple.withValues(alpha: 0.3),
                        blurRadius: 24,
                        offset: const Offset(0, 12),
                      ),
                    ],
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Row(
                        children: [
                          Container(
                            width: 50,
                            height: 50,
                            decoration: BoxDecoration(
                              color: Colors.white.withValues(alpha: 0.2),
                              borderRadius: BorderRadius.circular(16),
                            ),
                            child: const Icon(Icons.psychology_alt_rounded,
                                color: Colors.white, size: 30),
                          ),
                          const SizedBox(width: 14),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'QuizMaster',
                                  style: theme.textTheme.headlineSmall
                                      ?.copyWith(
                                    color: Colors.white,
                                    fontWeight: FontWeight.w900,
                                  ),
                                ),
                                Text(
                                  'Smart Quiz Practice App',
                                  style: theme.textTheme.bodyMedium?.copyWith(
                                    color: Colors.white.withValues(alpha: 0.85),
                                  ),
                                ),
                              ],
                            ),
                          ),
                        ],
                      ),
                      const SizedBox(height: 24),
                      Text(
                        'Welcome back, $kStudentFirstName!',
                        style: theme.textTheme.titleLarge?.copyWith(
                          color: Colors.white,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        history.isEmpty
                            ? 'Pick a category below and take your first quiz.'
                            : 'You have an average of ${fmtPercent(history.averagePercent)} so far. Keep going!',
                        style: theme.textTheme.bodyMedium?.copyWith(
                          color: Colors.white.withValues(alpha: 0.9),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ),
          ),
          SliverToBoxAdapter(
            child: Padding(
              padding: const EdgeInsets.fromLTRB(16, 16, 16, 0),
              child: FadeSlideIn(
                delayMs: 100,
                child: Row(
                  children: [
                    Expanded(
                      child: StatCard(
                        icon: Icons.task_alt_rounded,
                        label: 'Quizzes completed',
                        value: '${history.length}',
                        color: kBlue,
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: StatCard(
                        icon: Icons.emoji_events_rounded,
                        label: 'Highest score',
                        value: history.isEmpty
                            ? '--'
                            : fmtPercent(history.bestPercent),
                        color: kPurple,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          const SliverToBoxAdapter(
            child: Padding(
              padding: EdgeInsets.fromLTRB(16, 24, 16, 12),
              child: SectionTitle(
                'Quiz Categories',
                subtitle: 'Choose a subject to start practising',
              ),
            ),
          ),
          SliverPadding(
            padding: const EdgeInsets.fromLTRB(16, 0, 16, 24),
            sliver: SliverGrid(
              gridDelegate: const SliverGridDelegateWithMaxCrossAxisExtent(
                maxCrossAxisExtent: 240,
                mainAxisExtent: 184,
                crossAxisSpacing: 12,
                mainAxisSpacing: 12,
              ),
              delegate: SliverChildBuilderDelegate(
                (context, i) => FadeSlideIn(
                  delayMs: i * 70,
                  child: CategoryCard(
                    category: kCategories[i],
                    onTap: () => _showStartSheet(context, kCategories[i]),
                  ),
                ),
                childCount: kCategories.length,
              ),
            ),
          ),
        ],
      ),
    );
  }
}

// ============================================================================
// QUIZ SCREEN
// ============================================================================

class QuizScreen extends StatefulWidget {
  final QuizCategory category;
  final ValueChanged<QuizResult> onComplete;

  const QuizScreen({
    super.key,
    required this.category,
    required this.onComplete,
  });

  @override
  State<QuizScreen> createState() => _QuizScreenState();
}

class _QuizScreenState extends State<QuizScreen> {
  late final List<Question> _questions;
  late final List<int> _selected;
  late final int _totalSeconds;
  late int _remaining;
  int _index = 0;
  bool _submitted = false;
  Timer? _timer;

  @override
  void initState() {
    super.initState();
    _questions = List<Question>.of(widget.category.questions)..shuffle();
    _selected = List<int>.filled(_questions.length, -1);
    _totalSeconds = _questions.length * kSecondsPerQuestion;
    _remaining = _totalSeconds;
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (!mounted || _submitted) {
        timer.cancel();
        return;
      }
      setState(() => _remaining--);
      if (_remaining <= 0) {
        _finish(auto: true);
      }
    });
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  void _select(int option) {
    setState(() {
      // Tapping the selected option again clears the answer.
      _selected[_index] = _selected[_index] == option ? -1 : option;
    });
  }

  void _goTo(int i) {
    if (i < 0 || i >= _questions.length) return;
    setState(() => _index = i);
  }

  Future<void> _confirmSubmit() async {
    final unanswered = _selected.where((s) => s < 0).length;
    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        icon: const Icon(Icons.assignment_turned_in_rounded,
            size: 36, color: kIndigo),
        title: const Text('Submit quiz?'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
                'You have answered ${_questions.length - unanswered} of ${_questions.length} questions.'),
            if (unanswered > 0) ...[
              const SizedBox(height: 8),
              Text(
                '$unanswered question(s) are unanswered and will score 0.',
                style: TextStyle(color: Colors.red.shade600),
              ),
            ],
            const SizedBox(height: 8),
            const Text('You cannot change your answers after submitting.'),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text('Keep working'),
          ),
          FilledButton(
            style: FilledButton.styleFrom(minimumSize: const Size(96, 44)),
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text('Submit'),
          ),
        ],
      ),
    );
    if (ok == true && mounted) {
      _finish(auto: false);
    }
  }

  Future<void> _confirmQuit() async {
    final quit = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        icon: const Icon(Icons.exit_to_app_rounded, size: 34),
        title: const Text('Quit quiz?'),
        content: const Text(
            'Your progress will be lost and this attempt will not be saved.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.of(ctx).pop(false),
            child: const Text('Continue quiz'),
          ),
          FilledButton(
            style: FilledButton.styleFrom(minimumSize: const Size(96, 44)),
            onPressed: () => Navigator.of(ctx).pop(true),
            child: const Text('Quit'),
          ),
        ],
      ),
    );
    if (quit == true && mounted) {
      Navigator.of(context).pop();
    }
  }

  void _finish({required bool auto}) {
    if (_submitted || !mounted) return;
    _submitted = true;
    _timer?.cancel();

    final review = <ReviewItem>[
      for (var i = 0; i < _questions.length; i++)
        ReviewItem(_questions[i], _selected[i]),
    ];
    final correct = review.where((r) => r.answered && r.correct).length;
    final unanswered = review.where((r) => !r.answered).length;
    final incorrect = review.length - correct - unanswered;
    final taken = math.max(0, math.min(_totalSeconds, _totalSeconds - _remaining));

    final result = QuizResult(
      category: widget.category,
      total: review.length,
      correct: correct,
      incorrect: incorrect,
      unanswered: unanswered,
      secondsTaken: taken,
      completedAt: DateTime.now(),
      review: review,
    );
    widget.onComplete(result);

    // Removes the quiz screen (and any open dialog) and shows the result.
    Navigator.of(context).pushAndRemoveUntil(
      fadeSlideRoute<void>(ResultScreen(result: result, autoSubmitted: auto)),
      (route) => route.isFirst,
    );
  }

  Widget _buildPalette() {
    final scheme = Theme.of(context).colorScheme;
    return SizedBox(
      height: 46,
      child: ListView.separated(
        scrollDirection: Axis.horizontal,
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
        itemCount: _questions.length,
        separatorBuilder: (context, i) => const SizedBox(width: 8),
        itemBuilder: (context, i) {
          final current = i == _index;
          final answered = _selected[i] >= 0;
          return InkWell(
            customBorder: const CircleBorder(),
            onTap: () => _goTo(i),
            child: AnimatedContainer(
              duration: const Duration(milliseconds: 200),
              width: 38,
              height: 38,
              alignment: Alignment.center,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: current
                    ? scheme.primary
                    : answered
                        ? scheme.primaryContainer
                        : Colors.white,
                border: Border.all(
                  color: current || answered
                      ? scheme.primary
                      : Colors.grey.shade300,
                  width: 1.4,
                ),
              ),
              child: Text(
                '${i + 1}',
                style: TextStyle(
                  fontWeight: FontWeight.w700,
                  color: current ? Colors.white : scheme.onSurface,
                ),
              ),
            ),
          );
        },
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final scheme = theme.colorScheme;
    final n = _questions.length;
    final q = _questions[_index];
    final answered = _selected.where((s) => s >= 0).length;
    final lowTime = _remaining <= 60;
    final isLast = _index == n - 1;

    return PopScope(
      canPop: false,
      onPopInvokedWithResult: (didPop, result) async {
        if (didPop) return;
        await _confirmQuit();
      },
      child: Scaffold(
        appBar: AppBar(
          title: Text(
            widget.category.name,
            style: const TextStyle(fontWeight: FontWeight.w800),
          ),
          actions: [
            Padding(
              padding: const EdgeInsets.only(right: 14),
              child: AnimatedContainer(
                duration: const Duration(milliseconds: 300),
                padding:
                    const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                decoration: BoxDecoration(
                  color: lowTime ? Colors.red.shade50 : scheme.primaryContainer,
                  borderRadius: BorderRadius.circular(20),
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Icon(
                      Icons.timer_rounded,
                      size: 18,
                      color: lowTime ? Colors.red.shade600 : scheme.primary,
                    ),
                    const SizedBox(width: 6),
                    Text(
                      fmtDuration(_remaining),
                      style: TextStyle(
                        fontWeight: FontWeight.w800,
                        fontFeatures: const [FontFeature.tabularFigures()],
                        color: lowTime ? Colors.red.shade600 : scheme.primary,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ],
        ),
        body: ResponsiveBody(
          maxWidth: 760,
          child: Column(
            children: [
              Padding(
                padding: const EdgeInsets.fromLTRB(16, 4, 16, 8),
                child: Column(
                  children: [
                    Row(
                      children: [
                        Text(
                          'Question ${_index + 1} of $n',
                          style: theme.textTheme.titleSmall
                              ?.copyWith(fontWeight: FontWeight.w800),
                        ),
                        const Spacer(),
                        Text(
                          '$answered answered',
                          style: theme.textTheme.bodySmall
                              ?.copyWith(color: Colors.blueGrey.shade600),
                        ),
                      ],
                    ),
                    const SizedBox(height: 8),
                    TweenAnimationBuilder<double>(
                      tween: Tween<double>(begin: 0, end: (_index + 1) / n),
                      duration: const Duration(milliseconds: 350),
                      curve: Curves.easeOut,
                      builder: (context, value, _) => LinearProgressIndicator(
                        value: value,
                        minHeight: 8,
                        borderRadius: BorderRadius.circular(8),
                      ),
                    ),
                  ],
                ),
              ),
              _buildPalette(),
              Expanded(
                child: SingleChildScrollView(
                  padding: const EdgeInsets.fromLTRB(16, 8, 16, 16),
                  child: AnimatedSwitcher(
                    duration: const Duration(milliseconds: 300),
                    transitionBuilder: (child, animation) => FadeTransition(
                      opacity: animation,
                      child: SlideTransition(
                        position: Tween<Offset>(
                          begin: const Offset(0.05, 0),
                          end: Offset.zero,
                        ).animate(animation),
                        child: child,
                      ),
                    ),
                    child: Column(
                      key: ValueKey<int>(_index),
                      crossAxisAlignment: CrossAxisAlignment.stretch,
                      children: [
                        AppCard(
                          padding: const EdgeInsets.all(20),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Container(
                                padding: const EdgeInsets.symmetric(
                                    horizontal: 10, vertical: 4),
                                decoration: BoxDecoration(
                                  color: kIndigo.withValues(alpha: 0.1),
                                  borderRadius: BorderRadius.circular(10),
                                ),
                                child: Text(
                                  'Q${_index + 1}',
                                  style: const TextStyle(
                                    color: kIndigo,
                                    fontWeight: FontWeight.w800,
                                  ),
                                ),
                              ),
                              const SizedBox(height: 12),
                              Text(
                                q.text,
                                style: theme.textTheme.titleMedium?.copyWith(
                                  fontWeight: FontWeight.w700,
                                  height: 1.4,
                                  color: const Color(0xFF1E1B4B),
                                ),
                              ),
                            ],
                          ),
                        ),
                        const SizedBox(height: 16),
                        for (var i = 0; i < q.options.length; i++)
                          OptionTile(
                            label: String.fromCharCode(65 + i),
                            text: q.options[i],
                            selected: _selected[_index] == i,
                            onTap: () => _select(i),
                          ),
                      ],
                    ),
                  ),
                ),
              ),
              Container(
                padding: const EdgeInsets.fromLTRB(16, 12, 16, 12),
                decoration: BoxDecoration(
                  color: Colors.white,
                  boxShadow: [
                    BoxShadow(
                      color: kIndigo.withValues(alpha: 0.08),
                      blurRadius: 16,
                      offset: const Offset(0, -4),
                    ),
                  ],
                ),
                child: Row(
                  children: [
                    Expanded(
                      child: OutlinedButton.icon(
                        onPressed: _index > 0 ? () => _goTo(_index - 1) : null,
                        icon: const Icon(Icons.arrow_back_rounded),
                        label: const Text('Previous'),
                      ),
                    ),
                    const SizedBox(width: 12),
                    Expanded(
                      child: isLast
                          ? FilledButton.icon(
                              onPressed: _confirmSubmit,
                              icon: const Icon(Icons.check_circle_rounded),
                              label: const Text('Submit'),
                            )
                          : FilledButton.icon(
                              onPressed: () => _goTo(_index + 1),
                              icon: const Icon(Icons.arrow_forward_rounded),
                              label: const Text('Next'),
                            ),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

